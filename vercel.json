{
    "headers": [{
        "source": "/(.*)",
        "headers": [{
                "key": "Content-Security-Policy",
                "value": "default-src 'self' https: 'unsafe-inline' 'unsafe-eval'; img-src 'self' data:; object-src 'none'"
            },
            {
                "key": "X-Content-Type-Options",
                "value": "nosniff"
            },
            {
                "key": "X-Frame-Options",
                "value": "DENY"
            },
            {
                "key": "Permissions-Policy",
                "value": "geolocation=(), microphone=(), camera=()"
            }
        ]
    }]
}