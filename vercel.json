{
    "headers": [{
        "source": "/(.*)",
        "headers": [{
                "key": "Content-Security-Policy",
                "value": "default-src 'self' https: 'unsafe-inline'; img-src 'self' data: https:; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https:; font-src 'self' https: data:;"
            },
            {
                "key": "X-Content-Type-Options",
                "value": "nosniff"
            },
            {
                "key": "X-Frame-Options",
                "value": "DENY"
            },
            {
                "key": "Permissions-Policy",
                "value": "geolocation=(), microphone=(), camera=()"
            }
        ]
    }]
}